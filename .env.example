# Copy to .env (or .env.local) and fill in. Nothing here is secret except
# GEMINI_API_KEY: the VITE_* values are compiled into the client bundle by
# design, exactly as the vendors' own snippets would be.

# --- Server -----------------------------------------------------------------

# GEMINI_API_KEY: required for the AI biography / timeline / memory endpoints
# in server.ts. Without it those endpoints return an error and the rest of the
# app keeps working.
GEMINI_API_KEY=""

# APP_URL: public origin the app is served from. Used for self-referential
# links and callbacks.
APP_URL="https://remembered8.com"

# --- Client (compiled into the bundle by Vite) -------------------------------

# Public site origin, used for canonical URLs and the sitemap.
VITE_SITE_URL="https://remembered8.com"

# Google Analytics 4 measurement id (Admin -> Data streams -> Web).
# Format: G-XXXXXXXXXX. Leave empty to disable GA4 entirely.
VITE_GA4_ID=""

# Microsoft Clarity project id (Settings -> Overview -> Project id).
# Format: a short alphanumeric string, e.g. abcd1234ef. Leave empty to disable.
VITE_CLARITY_ID=""

# Meta (Facebook) Pixel id (Events Manager -> Data sources).
# Format: digits only. Leave empty to disable the pixel.
VITE_META_PIXEL_ID=""

# Optional: overrides the Gemini model id if the default is retired.
GEMINI_MODEL=""
